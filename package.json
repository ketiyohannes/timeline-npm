{
  "name": "@ketiyohannes/timeline",
  "version": "0.1.0",
  "description": "Open a local visual timeline for any Git codebase",
  "keywords": [
    "codex",
    "git",
    "timeline",
    "code-review",
    "history",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "ketiyohannes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketiyohannes/timeline-npm.git"
  },
  "homepage": "https://github.com/ketiyohannes/timeline-npm#readme",
  "bugs": "https://github.com/ketiyohannes/timeline-npm/issues",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "bin": {
    "timeline": "bin/timeline",
    "timeline-hook": "bin/timeline-hook",
    "install-timeline-hooks": "bin/install-hooks",
    "codex-timeline": "bin/codex-timeline",
    "codex-timeline-hook": "bin/codex-timeline-hook"
  },
  "files": [
    "bin",
    "src",
    "web",
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:compat": "./tests/test_recorder.sh && ./tests/test_hook.sh",
    "check": "npm test && npm run test:compat && npm pack --dry-run"
  }
}
